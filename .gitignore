# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.rigging-studio/*
!/.rigging-studio/projects/
/.rigging-studio/projects/*
!/.rigging-studio/projects/.gitkeep

# Pose model weights, fetched by scripts/fetch-pose-model.sh (npm run setup:pose)
/public/models/dwpose/

# Background services started by npm run studio:up
/.studio/
/.bench/
/tests/fixtures/bench-rigs/last-report.json

# Brainstorming mockups (superpowers visual companion)
/.superpowers/

# scratch experiments
/scripts/.tmp/
