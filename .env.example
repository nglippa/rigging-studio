# Optional. Leave unset to use the isolated local mock provider.
# This URL must point to a server endpoint that owns any model API credentials.
NEXT_PUBLIC_AI_ANIMATION_ENDPOINT=

# Optional visual-review endpoint. Receives multipart diagnostic images and JSON context.
# Keep vision-model credentials on the server; this value is only an endpoint location.
NEXT_PUBLIC_AI_VISION_ENDPOINT=
# Optional server-side character AI proxy. This is an endpoint URL, never an API key.
# The browser posts provider-neutral { capability, body } requests to this proxy.
NEXT_PUBLIC_CHARACTER_PIPELINE_ENDPOINT=

# Optional local ComfyUI image-production backend. Only localhost HTTP URLs are accepted.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Exact filename of an already installed ComfyUI checkpoint used by the trusted generation workflow.
COMFYUI_CHECKPOINT=
COMFYUI_EXECUTION_TIMEOUT_MS=600000
# Optional only when the MCP bridge uses a non-default local address.
NEXT_PUBLIC_RIGGING_STUDIO_BRIDGE_URL=http://127.0.0.1:47831
