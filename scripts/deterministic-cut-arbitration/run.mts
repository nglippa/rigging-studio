const ROOT = path.resolve(import.meta.dirname, "../.."); const RUN_ID = process.env.DETERMINISTIC_CUT_RUN_ID ?? "2026-08-25T11-13-56Z"; const OUTPUT = path.join(ROOT, ".rigging-studio/diagnostics/deterministic-cut-arbitration", RUN_ID); const PRIOR = path.join(ROOT, ".rigging-studio/diagnostics/vision-cut-arbitration/2026-08-25T10-00-00Z");
